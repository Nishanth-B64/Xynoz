# Copy to .env for local development. Never commit a real key.
GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
SUPABASE_JWT_SECRET=replace-with-project-jwt-signing-secret
SUPABASE_ROOM_TABLE=rooms
SUPABASE_STORAGE_BUCKET=chat-files
# Comma-separated origins when embedding the app on another domain; same-origin is the default.
SOCKETIO_CORS_ORIGINS=
